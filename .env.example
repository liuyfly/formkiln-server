# Copy to .env (git-ignored) and adjust. Spring Boot imports this file at startup.
FORMKILN_DB_URL=jdbc:postgresql://localhost:5432/formkiln
FORMKILN_DB_USERNAME=formkiln
FORMKILN_DB_PASSWORD=change-me

# Bearer token for the management API. Leave empty to disable it.
FORMKILN_SERVICE_TOKEN=change-me-to-a-long-random-string

# 32 random bytes, Base64: openssl rand -base64 32 (required)
FORMKILN_ENCRYPTION_KEY=
# Invited as the first admin when there are no members yet.
FORMKILN_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
FORMKILN_ADMIN_URL=http://localhost:3200
FORMKILN_SMTP_HOST=localhost
FORMKILN_SMTP_PORT=1025

# Requests per minute and client IP to runtime writes (submissions, drafts, uploads).
FORMKILN_RUNTIME_RATE_LIMIT=60
# Uploaded files: filesystem (default) or s3.
FORMKILN_MAX_FILE_SIZE=10MB
FORMKILN_STORAGE=filesystem
FORMKILN_STORAGE_PATH=./data/files
# FORMKILN_S3_BUCKET=
# FORMKILN_S3_REGION=us-east-1
# FORMKILN_S3_ENDPOINT=
# FORMKILN_S3_PATH_STYLE=false
# FORMKILN_S3_ACCESS_KEY=
# FORMKILN_S3_SECRET_KEY=

# Cloudflare Turnstile for public forms. Leave empty to disable.
# FORMKILN_TURNSTILE_SITE_KEY=
# FORMKILN_TURNSTILE_SECRET=

# Development only: let webhooks reach http:// and private addresses.
# FORMKILN_WEBHOOKS_ALLOW_HTTP=true
# FORMKILN_WEBHOOKS_ALLOW_PRIVATE_NETWORKS=true
